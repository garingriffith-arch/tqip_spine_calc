# SPINE-TRACT research repository: no ACS individual-level data
.Rhistory
.RData
.Rproj.user/
.Renviron
.env
.env.*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.tmp
*.bak
rsconnect/

# Restricted source data and patient-level/derived modeling outputs
data/raw/
data/derived/
output/
outputs/
cache/
checkpoints/
*.parquet
*.feather
*.fst
*.xlsx
*.xls
*.zip

# Patient-level and intermediate R objects are not publishable by default
*.rds
*.RData
*.rda
*.qs

# Preserve previously committed legacy app artifacts.
# These are NOT the final revised-manuscript deployment models.
!data/model_bundle.rds
!data/predictor_metadata.rds

# Archive aggregate CSVs only by explicit review/allow-list
*.csv
!analytic_pipeline/PIPELINE_MANIFEST.csv
!analytic_pipeline/SOURCE_ARCHIVE_MANIFEST.csv
!analytic_pipeline/reference/
!analytic_pipeline/reference/spine_operative_icd10pcs_map.csv

# Application deployment manifest retained
!manifest.json

# Local workstation configuration is not versioned
R/00_config.R

# Explicitly publish ONLY final, reviewed 2020–2024 deployment models,
# encoders, and artifact provenance (analogous to the TBI-TRACT repository).
# Never commit source ACS PUFs, row-wise predictions, record IDs or QC extracts.
!data/deployment_2020_2024/models/
!data/deployment_2020_2024/models/*.json
!data/deployment_2020_2024/encoders/
!data/deployment_2020_2024/encoders/*_encoder.rds
!data/deployment_2020_2024/artifact_manifest.csv
data/deployment_2020_2024/qc/
